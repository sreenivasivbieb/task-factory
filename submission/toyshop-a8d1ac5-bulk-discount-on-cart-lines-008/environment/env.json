{
  "schema_version": 1,
  "base_image": "python:3.11-slim",
  "setup_commands": [
    "pip install -q -e '.[test]'",
    "pip install -q pytest"
  ],
  "test_command": "python -m pytest -p no:cacheprovider -q -o junit_family=xunit1 --junitxml={report} {select}",
  "test_timeout_s": 600,
  "env_vars": {},
  "workdir": "/repo",
  "framework": "pytest",
  "report_format": "junit",
  "report_path": ".factory/report.xml"
}
